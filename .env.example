# ==============================================================================
# AI Banking Financial Intelligence - Environment Configuration
# ==============================================================================
# DO NOT commit real secrets or credentials to version control.
# Copy this file to .env.local for local Next.js development.

# PostgreSQL Analytical Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Supports hosted PostgreSQL providers such as Neon, Supabase, AWS RDS, Railway, Render.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_banking_db

# Google Gemini API Configuration (Server-Side Only)
# Never prefix with NEXT_PUBLIC_ to prevent browser exposure.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Public Branding & Portfolio Configuration (Client-Side Safe)
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/YOUR_PROFILE/
